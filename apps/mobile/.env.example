# Copy to .env (never commit .env). EXPO_PUBLIC_* values are bundled into the app: no secrets here.
EXPO_PUBLIC_API_URL=https://api.mimt.ca
EXPO_PUBLIC_TAKATAK_ISSUER=https://takatak.ca
EXPO_PUBLIC_TAKATAK_CLIENT_ID=mimt-mobile

# Build-time only (read by app.config.ts, not bundled):
# Path to the Firebase Android config (FCM, needed by Twilio incoming calls and expo-notifications).
GOOGLE_SERVICES_JSON=./google-services.json
# "development" for dev builds, "production" for TestFlight/App Store (APNs VoIP environment).
APS_ENVIRONMENT=development
# EAS project id (from `eas init`), used for Expo push tokens and updates.
EAS_PROJECT_ID=
# AdMob app ids. Default to Google's public sample (test) app ids.
ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
